# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# demo = synthetic data, local = Work IQ CLI sign-in, remote = app registration/OBO.
WORK_IQ_MODE=local
TENANT_DISPLAY_NAME=Microsoft
DISPLAY_USER_NAME=Your Name
DISPLAY_USER_EMAIL=your.name@yourcompany.com
DISPLAY_TENANT_ID=your-tenant-label
WORK_IQ_LOCAL_ACCOUNT=your.name@yourcompany.com

# Express API app registration
ENTRA_API_CLIENT_ID=
ALLOWED_TENANT_IDS=

# OBO confidential-client credential. Use a certificate in production.
ENTRA_CLIENT_SECRET=
ENTRA_CERT_THUMBPRINT=
# A PEM value can use literal \n characters on one line.
ENTRA_CERT_PRIVATE_KEY=

# Work IQ
WORK_IQ_MCP_ENDPOINT=https://workiq.svc.cloud.microsoft/mcp
WORK_IQ_SCOPE=api://workiq.svc.cloud.microsoft/WorkIQAgent.Ask
WORK_IQ_TIMEOUT_MS=90000
